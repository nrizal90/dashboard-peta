<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /

	# Biarkan file & folder yang benar-benar ada diakses langsung (assets, dsb.)
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d

	# Selain itu, arahkan semua request ke index.php (front controller CI3)
	RewriteRule ^(.*)$ index.php/$1 [L]
</IfModule>

<IfModule !mod_rewrite.c>
	ErrorDocument 404 /index.php
</IfModule>
